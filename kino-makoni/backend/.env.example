# Kino Makoni backend — muhit o'zgaruvchilari namunasi.
# Nusxa oling: cp .env.example .env — va qiymatlarni to'ldiring.
# Hammasi app/core/config.py (Settings) orqali o'qiladi.

# ===================== Umumiy =====================
# production | development | test
APP_ENV=production
LOG_LEVEL=INFO

# iOS ilova murojaat qiladigan asosiy manzil (oxirida "/" siz).
# Stream/thumb URL'lari ham shu asosda yasaladi (agar STREAM_PUBLIC_BASE_URL bo'sh bo'lsa).
API_PUBLIC_BASE_URL=https://api.kinomakoni.uz

# Video trafigi uchun ALOHIDA domen (masalan Cloudflare proxy'siz to'g'ridan-to'g'ri
# serverga chiqish uchun). Bo'sh qoldirilsa API_PUBLIC_BASE_URL ishlatiladi.
STREAM_PUBLIC_BASE_URL=

# JWT (access token) va imzolangan stream/thumb URL'lar uchun maxfiy kalit.
# KAMIDA 32 BELGI, tasodifiy va maxfiy bo'lishi shart (masalan: openssl rand -hex 32).
SECRET_KEY=change-me-to-a-random-32-plus-character-secret

# CORS ruxsat etilgan manbalar, vergul bilan (masalan: https://app.kinomakoni.uz).
# Bo'sh bo'lsa — hammasiga ruxsat ("*"), lekin credentials o'chirilgan holda.
CORS_ORIGINS=

# ===================== Ilova bazasi (botnikidan ALOHIDA) =====================
# Bu — Kino Makoni iOS ilovasining O'Z bazasi (users/titles/favorites/progress).
# Prod'da PostgreSQL, testlarda SQLite ishlatiladi.
DATABASE_URL=postgresql+asyncpg://kino_makoni:password@localhost:5432/kino_makoni

# ===================== Bot bazasi — FAQAT O'QISH =====================
# Kino-makon botining PostgreSQL (Neon) bazasiga FAQAT O'QISH huquqli rol bilan
# ulanish satri. Bu backend botga HECH QACHON yozmaydi (ikkalanchi himoya: rol
# ham, kod ham read-only tranzaksiya bilan ishlaydi).
#
# Bot bazasida (bot ishlaydigan Postgres'da) quyidagi SQL orqali maxsus,
# FAQAT O'QISH huquqli rol yarating (superuser/admin sifatida bir marta):
#
#   CREATE ROLE kino_makoni_reader LOGIN PASSWORD 'kuchli-parol-shu-yerga';
#   GRANT CONNECT ON DATABASE <bot_baza_nomi> TO kino_makoni_reader;
#   GRANT USAGE ON SCHEMA public TO kino_makoni_reader;
#   GRANT SELECT ON movies, serials, seasons, episodes TO kino_makoni_reader;
#   ALTER ROLE kino_makoni_reader SET default_transaction_read_only = on;
#
# Bo'sh qoldirilsa — katalog sinxronizatsiyasi ishga tushmaydi (backend baribir
# ishlaydi, faqat katalog bo'sh bo'ladi).
BOT_DATABASE_URL=postgresql://kino_makoni_reader:kuchli-parol-shu-yerga@bot-db-host:5432/bot_baza_nomi

# Katalogni necha soniyada bir marta to'liq qayta sinxronlash kerak.
CATALOG_SYNC_INTERVAL_SEC=300

# ===================== Telegram MTProto (video stream uchun) =====================
# my.telegram.org'dan olinadigan API ID/HASH (asosiy bot tokenidan FARQLI —
# alohida "yordamchi" foydalanuvchi/bot sessiyasi kerak, MTProto orqali video
# oqimini o'qish uchun).
TG_API_ID=0
TG_API_HASH=

# YANGI, alohida yaratilgan yordamchi bot tokeni (@BotFather). Kino-makon
# botining ASOSIY tokeni EMAS — shu bilan bir xil tokendan foydalanish
# ikkala tizimni ham beqaror qiladi.
TG_HELPER_BOT_TOKEN=

# Kino-makon botining maxfiy "baza" kanali (-100... ko'rinishida). Videolar
# aynan shu kanalda saqlanadi — stream/thumb shu yerdan o'qiydi.
TG_BASE_CHANNEL_ID=0

# MTProto sessiya fayli saqlanadigan katalog (Docker'da /data volume'ga mos).
TG_SESSION_DIR=/data

# MTProto so'rov bo'lagi hajmi (bayt). Standart qiymat aksariyat holatda yetarli.
TG_CHUNK_SIZE=524288

# ===================== Kontent =====================
# TMDB API kaliti (ixtiyoriy) — kino-makon botida yo'q kinolar uchun
# poster/backdrop rasmlarini avtomatik topib qo'yadi. Bo'sh bo'lsa — shunchaki
# Telegram video thumbnail'i ishlatiladi.
TMDB_API_KEY=

# true bo'lsa — is_premium=true kinolar ilovada 403 premium_required qaytaradi
# (hozircha ilovada premium xarid oqimi yo'q, shuning uchun bunday kontent
# hammaga yopiq bo'ladi).
PREMIUM_ENFORCED=true

# ===================== Tokenlar =====================
# JWT access token necha kun amal qiladi.
ACCESS_TOKEN_TTL_DAYS=30

# Imzolangan stream URL necha soniya amal qiladi (AVPlayer shu muddat ichida
# video oqimini ochishi kerak).
PLAYBACK_URL_TTL_SEC=21600

# ===================== Cloudflare R2 (keyingi bosqich) =====================
# Admin panel orqali fayl yuklash uchun (hozircha ishlatilmaydi).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
